# ======================================================
# 🌐 SGAD AVAILABILITY SERVICE — CONFIGURACIÓN DE ENTORNO
# ======================================================

# --- General ---
ENVIRONMENT=development
SERVICE_NAME=SGAD Availability Service
VERSION=1.0.0

# --- Base de datos ---
# Cambia los valores de usuario y contraseña según docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@sgad-db:5432/sgad_availability

# --- Integración con AUTH SERVICE ---
AUTH_URL=http://sgad-auth-service:4000/validate

# --- Configuración de la ventana de disponibilidad ---
# Los árbitros pueden registrar su disponibilidad desde el jueves 8:00
# hasta el viernes 14:00; luego se cierra automáticamente a las 15:00.
OPEN_DAY=thursday
OPEN_HOUR=8
CLOSE_DAY=friday
CLOSE_HOUR=14
RESET_HOUR=15

# --- Clave secreta del servicio (solo para validaciones internas) ---
SECRET_KEY=supersecretkey

# --- Scheduler (no modificar salvo necesidad) ---
# Cierre semanal todos los viernes a las 15:00 (manejado por APScheduler)
# No requiere configuración adicional.

# --- Puerto interno de FastAPI ---
PORT=8000
